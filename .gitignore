# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------
# Local provider / module cache
**/.terraform/*

# State files (state lives in S3; bootstrap/ uses local state, keep a backup elsewhere)
*.tfstate
*.tfstate.*

# Saved plans (may contain sensitive values)
*.tfplan
tfplan
tfplan-destroy

# Crash logs
crash.log
crash.*.log

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# Variable files may contain secrets; terraform.tfvars.example stays tracked
*.tfvars
*.tfvars.json

# Provider lock files are not tracked in this repo.
.terraform.lock.hcl

# Local Claude Code context (kept out of the public repo)
CLAUDE.md
.claude/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
# CI plan logs (written by .github/scripts/plan-layers.sh)
plan-output/

# Per-environment Terraform data directories (see scripts/tf.sh)
.terraform-data/

# Python bytecode (scripts/*.py)
__pycache__/
*.pyc
