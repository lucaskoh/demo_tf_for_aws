# Copy to terraform.tfvars (git-ignored) and edit.
# In CI these values come from GitHub repository variables instead.

region = "ap-northeast-1"
# Optional: set both to get demo.example.com. Without a domain the demo is
# reached through the NLB DNS name (see the demo_url_* outputs).
# domain_name = "example.com" # an existing public Route 53 hosted zone
# record_name = "demo"        # -> demo.example.com

# Local runs only: IAM users/roles that get cluster-admin on EKS.
# Use the role ARN, not an assumed-role session ARN.
eks_admin_principal_arns = ["arn:aws:iam::123456789012:user/your-user"]

# Optional overrides
# name               = "demo"
# vpc_a_cidr         = "10.0.0.0/16"
# vpc_b_cidr         = "10.1.0.0/16"
# ec2_private_ip     = "10.1.1.100"
# kubernetes_version = "1.33"
